{
  "name": "polywhale-autotrader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite --host 127.0.0.1",
    "server:dev": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.js",
    "worker:real": "node server/real-worker.js",
    "test": "vitest run",
    "backtest:gates": "node scripts/backtest-copy-gates.js"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.0.6",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "pg": "^8.21.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "viem": "^2.51.2",
    "vite": "^7.3.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "vitest": "^4.1.6"
  }
}
